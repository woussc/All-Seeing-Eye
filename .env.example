# All-Seeing-Eye Environment Template
# SECURITY: Never put real keys in this file or anywhere inside the repository.
# Store live/testnet exchange keys and bot tokens in an external directory outside the repo
# (e.g., /etc/ase-secrets/) mounted read-only into Docker at /run/secrets.

ASE_MODE=paper
ASE_CONFIG_PATH=config/system.yaml
ASE_FINALISTS_PATH=config/finalists.yaml
ASE_DB_PATH=.runtime/ase.db
ASE_SECRETS_DIR=/etc/ase-secrets

# Gemini 4 Hydrogen REFLEX provider (optional in paper/offline mode; required for live LLM REFLEX)
# GEMINI_API_KEY=   # Set in external secret file /etc/ase-secrets/gemini_api_key
ASE_REFLEX_PROVIDER=deterministic
ASE_REFLEX_MODEL=gemini-4-hydrogen

# Exchange (Binance via ccxt, testnet first). Set keys ONLY in external secret files:
# /etc/ase-secrets/binance_api_key
# /etc/ase-secrets/binance_api_secret
ASE_EXCHANGE_TESTNET=true

# Telegram alerts (optional; set in /etc/ase-secrets/telegram_bot_token and telegram_chat_id)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# OpenMarket MCP Agent Token (optional; set in /etc/ase-secrets/openmarket_token)
# OPENMARKET_MCP_TOKEN=

# Explicit live approval gate — MUST stay false until owner grants written live approval
ASE_LIVE_APPROVED=false
ASE_LIVE_APPROVAL_TOKEN=
