{
  "name": "all-seeing-eye",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web --hostname 0.0.0.0 --port 3000",
    "build": "next build apps/web",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "tsx scripts/pages-smoke.ts",
    "start": "next start apps/web --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test apps/web/lib/*.test.ts",
    "test:browser": "tsx scripts/smoke.ts",
    "test:research-browser": "tsx scripts/research-smoke.ts",
    "format": "prettier --write apps/web/app apps/web/components apps/web/lib contracts scripts/smoke.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/public-sans": "5.2.7",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
